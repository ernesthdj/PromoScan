{
  "name": "promoscan",
  "version": "0.1.0",
  "private": true,
  "description": "Veille promotionnelle intelligente pour le marche belge",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "start": "node dist/api/server.js",
    "preview": "vite preview",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.60.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fuse.js": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
