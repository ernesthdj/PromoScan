# PromoScan — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# ─── Application ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL + PostGIS) ─────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/promoscan?schema=public

# ─── JWT Secrets (min 32 caracteres chacun) ──────────────
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-chars-min

# ─── Claude API ──────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...

# ─── OpenRouteService API ────────────────────────────────
ORS_API_KEY=your-ors-api-key-here

# ─── CORS (domaine frontend, separer par virgule si multiple) ─
CORS_ORIGIN=http://localhost:5173
