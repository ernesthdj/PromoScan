# PromoScan — Variables d'environnement (F1)
# Copier en .env.local pour le développement local. Ne jamais commit .env / .env.local.

# --- Base de données (Supabase Postgres via Prisma) ---
# Format Supabase : postgresql://postgres:<password>@<host>:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/promoscan"
# URL directe (non poolée) requise par `prisma migrate` avec Supabase/PgBouncer
DIRECT_URL="postgresql://user:password@localhost:5432/promoscan"

# --- Supabase (Auth + client) ---
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
# Service role : jamais exposé côté client, utilisé uniquement dans des contextes serveur
# nécessitant de bypasser Row Level Security (aucun usage F1 actuel, réservé si besoin futur).
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Cron (Vercel Cron Jobs) ---
# Secret partagé vérifié dans l'en-tête `Authorization: Bearer <CRON_SECRET>` des 4 endpoints
# /api/cron/collect-promotions/[chain]. Généré aléatoirement (ex. `openssl rand -hex 32`).
CRON_SECRET="changeme-generate-a-strong-random-secret"

# --- Fallback d'extraction IA (US-F1-05, P1 — Claude Vision pour documents PDF/image non structurés) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Adaptateurs enseignes (F1) ---
# Base URLs par défaut déjà en base (StoreChain.baseUrl) ; ces variables permettent une
# surcharge en environnement (staging/debug) sans migration DB.
COLRUYT_BASE_URL="https://ecgproductmw.colruyt.be"
ALDI_BASE_URL="https://www.aldi.be/fr/offres.html"
DELHAIZE_BASE_URL="https://www.delhaize.be"
LIDL_BASE_URL="https://www.lidl.be"

# User-Agent identifiable utilisé sur toutes les requêtes sortantes de scraping (US-F1-08)
SCRAPER_USER_AGENT="PromoScanBot/1.0 (+https://promoscan.app; contact: ernest.hdj@gmail.com)"

# --- Environnement ---
NODE_ENV="development"
